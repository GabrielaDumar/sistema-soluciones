# Backend y frontend en una imagen para el despliegue combinado.
FROM maven:3.9-eclipse-temurin-21 AS backend-build

WORKDIR /workspace/backend

COPY pom.xml .
COPY .mvn .mvn
COPY mvnw mvnw.cmd ./
RUN mvn dependency:go-offline -DskipTests

COPY src src
RUN mvn clean package -DskipTests

FROM ghcr.io/cirruslabs/flutter:stable AS frontend-build

WORKDIR /workspace/frontend

RUN rm -rf /sdks/flutter \
    && mkdir -p /sdks/flutter \
    && curl -fL https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.47.0-stable.tar.xz \
       | tar -xJ --strip-components=1 -C /sdks/flutter \
    && git config --global --add safe.directory '*' \
    && flutter --version

COPY mantenimiento_app/pubspec.* ./
RUN flutter pub get

COPY mantenimiento_app .

ARG API_BASE_URL=/api
RUN sed -i "s#http://10\\.0\\.2\\.2:8080/api#${API_BASE_URL}#g" \
    lib/services/api_service.dart \
    lib/screens/login_screen.dart \
    lib/screens/registro_screen.dart \
    && flutter build web --release --base-href /

FROM eclipse-temurin:21-jre-jammy AS frontend-runtime

ENV PORT=10000
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx gettext-base \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

COPY --from=frontend-build /workspace/frontend/build/web /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 10000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]